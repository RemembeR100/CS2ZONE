<%- include('partials/header') %>

<div class="container">
    <div class="grid-2">
        <div>
            <div class="card" style="background: linear-gradient(to bottom right, var(--bg-card), var(--bg-darker));">
                <div style="display:flex; align-items:center; gap:15px; margin-bottom:30px;">
                    <img src="<%= user.avatar || '/img/default_avatar.png' %>" class="sidebar-profile-img">
                    <div>
                        <h3 style="margin:0; font-size:18px;"><%= user.username %></h3>
                        <span style="color:var(--text-muted); font-weight:600; font-size:13px;"><i class="fas fa-id-badge"></i> #<%= user.id %></span>
                    </div>
                </div>
                
                <div class="section-title" style="margin-left:0;">Hızlı Erişim</div>
                <div class="sidebar-menu" style="display:flex; flex-direction:column; gap:8px;">
                    <a href="/chat" class="sidebar-item-card">
                        <span class="sidebar-item-title"><i class="fas fa-comments"></i> Mesajlar</span>
                    </a>
                </div>

                <div class="section-title" style="margin-top:30px; margin-left:0;">Timlerim</div>
                <% if(myGroups.length === 0) { %> <small style="color:var(--text-muted); display:block; padding:10px;">Henüz bir timin yok.</small> <% } %>
                <div style="display:flex; flex-direction:column; gap:15px;">
                    <% myGroups.forEach(g => { %>
                        <div class="sidebar-item-card" style="display:block; padding:15px;">
                            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                                <span class="sidebar-item-title"><i class="fas fa-shield-alt" style="color:var(--accent);"></i> <%= g.name %></span>
                                <span class="sidebar-item-badge"><%= g.memberCount %></span>
                            </div>
                            <div style="display:flex; gap:5px; flex-wrap:wrap;">
                                <% if(g.members && g.members.length > 0) { %>
                                    <% g.members.forEach(m => { %>
                                        <div title="<%= m.username %>" style="width:30px; height:30px; border-radius:50%; overflow:hidden; border:2px solid rgba(255,255,255,0.2);">
                                            <img src="<%= m.avatar || '/img/default_avatar.png' %>" style="width:100%; height:100%; object-fit:cover;">
                                        </div>
                                    <% }) %>
                                <% } %>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>

        <div>
            <% if(requests.length > 0) { %>
                <div class="card" style="border: 2px solid var(--accent); background: rgba(245, 158, 11, 0.05) !important; animation: pulse-border 2s infinite;">
                    <h3 style="color:var(--accent); margin-top:0;"><i class="fas fa-bell"></i> Bekleyen İstekler</h3>
                    <div style="display:flex; flex-direction:column; gap:10px;">
                        <% requests.forEach(r => { %>
                            <div class="sidebar-item-card" style="background:var(--bg-floating) !important;">
                                <div style="display:flex; align-items:center; gap:15px;">
                                    <div style="width:40px; height:40px; background:var(--accent); border-radius:50%; display:flex; align-items:center; justify-content:center; color:black; font-weight:bold;"><i class="fas fa-user"></i></div>
                                    <div><strong><%= r.username %></strong> <span style="opacity:0.7;">seni ekledi.</span></div>
                                </div>
                                <form action="/friend/accept" method="POST" style="margin:0; display:flex; gap:10px;">
                                    <input type="hidden" name="requestId" value="<%= r.request_id %>">
                                    <button type="submit" name="action" value="accept" class="btn btn-primary" style="padding:8px 20px; font-size:12px;">Onayla</button>
                                    <button type="submit" name="action" value="decline" class="btn btn-danger" style="padding:8px 20px; font-size:12px;">Reddet</button>
                                </form>
                            </div>
                        <% }) %>
                    </div>
                </div>
            <% } %>

            <div class="card">
                <h3><i class="fas fa-search" style="color:var(--primary); margin-right:10px;"></i> Oyuncu Bul</h3>
                <div style="display:flex; gap:15px;">
                    <input type="text" id="userSearch" placeholder="Oyuncu ismi girin..." onkeyup="searchUser()" style="margin:0; flex:1;">
                </div>
                <div id="searchResults" style="margin-top:20px; display:flex; flex-direction:column; gap:10px;"></div>
            </div>

            <div class="card">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
                    <h3 style="margin:0;"><i class="fas fa-users-cog"></i> Tim Yönetimi</h3>
                    <button onclick="document.getElementById('createGroupModal').style.display='flex'" class="btn btn-outline" style="font-size:12px;">+ Tim Kur</button>
                </div>
                
                <% if(myGroups.length > 0) { %>
                    <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap:15px;">
                        <% myGroups.forEach(g => { %>
                            <div style="background:var(--bg-floating); padding:15px; border-radius:10px; border:1px solid var(--border);">
                                <div style="display:flex; justify-content:space-between; align-items:center;">
                                    <strong style="color:var(--accent);"><%= g.name %></strong>
                                    <span style="font-size:11px; opacity:0.6;"><%= g.memberCount %> Üye</span>
                                </div>
                                <form action="/groups/add-member" method="POST" style="margin-top:10px; display:flex; gap:5px;">
                                    <input type="hidden" name="groupId" value="<%= g.id %>">
                                    <select name="memberId" style="margin:0; font-size:11px; padding:8px;">
                                        <option value="" disabled selected>Üye Ekle</option>
                                        <% friends.forEach(f => { %>
                                            <option value="<%= f.id %>"><%= f.username %></option>
                                        <% }) %>
                                    </select>
                                    <button type="submit" class="btn btn-primary" style="padding:0 10px;">+</button>
                                </form>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p style="opacity:0.6;">Timin yok.</p>
                <% } %>
            </div>

            <div class="card">
                <h3><i class="fas fa-user-group"></i> Arkadaş Listesi</h3>
                <% if(friends.length === 0) { %>
                    <div style="text-align:center; padding:30px; border:2px dashed var(--border); border-radius:10px; opacity:0.5;">Listen boş.</div>
                <% } else { %>
                    <div class="friend-grid">
                        <% friends.forEach(f => { %>
                            <div class="friend-mini-card">
                                <img src="<%= f.avatar || '/img/default_avatar.png' %>" class="friend-avatar">
                                <div style="font-weight:bold; font-size:13px; margin-bottom:5px;"><%= f.username %></div>
                                <a href="/chat" class="btn btn-primary" style="font-size:10px; padding:5px 10px; width:100%;">Mesaj</a>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<div id="createGroupModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.9); z-index:2000; align-items:center; justify-content:center;">
    <div class="card" style="width:400px; border:2px solid var(--accent);">
        <h2 style="margin-top:0;">Yeni Tim Kur</h2>
        <form action="/groups/create" method="POST">
            <input type="text" name="groupName" placeholder="Tim Adı" required>
            <textarea name="description" placeholder="Açıklama" rows="2"></textarea>
            <div style="display:flex; justify-content:flex-end; gap:10px;">
                <button type="button" onclick="document.getElementById('createGroupModal').style.display='none'" class="btn btn-outline">İptal</button>
                <button type="submit" class="btn btn-primary">Oluştur</button>
            </div>
        </form>
    </div>
</div>

<script>
    const myPendingIds = [<%= (typeof myPendingIds !== 'undefined' ? myPendingIds.join(',') : '') %>];
    
    async function searchUser() {
        const q = document.getElementById('userSearch').value;
        const div = document.getElementById('searchResults');
        if(q.length < 1) { div.innerHTML = ''; return; }
        
        const res = await fetch('/api/search-users?q=' + q);
        const data = await res.json();
        
        if(data.length === 0) { div.innerHTML = '<div style="padding:10px; text-align:center; opacity:0.5;">Bulunamadı.</div>'; return; }
        
        div.innerHTML = data.map(u => {
            const isPending = myPendingIds.includes(u.id);
            const btnHtml = isPending 
                ? '<button class="btn btn-outline" disabled style="padding:5px 10px; font-size:11px; opacity:0.5; border-color:var(--text-muted); color:var(--text-muted);">Bekleniyor...</button>' 
                : `<form action="/friend/request" method="POST" style="margin:0;"><input type="hidden" name="targetId" value="${u.id}"><button class="btn btn-primary" style="padding:5px 15px; font-size:11px;">Ekle</button></form>`;

            // DÜZELTME: class="search-result-img" EKLENDİ
            return `
            <div class="sidebar-item-card" style="margin:0;">
                <div style="display:flex; align-items:center; gap:10px;">
                    <img src="${u.avatar || '/img/default_avatar.png'}" class="search-result-img">
                    <div><div style="font-weight:700; font-size:13px;">${u.username}</div><small style="opacity:0.5;">#${u.id}</small></div>
                </div>
                ${btnHtml}
            </div>`;
        }).join('');
    }
</script>
<style>
    @keyframes pulse-border { 0% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.4); } 70% { box-shadow: 0 0 0 10px rgba(245, 158, 11, 0); } 100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0); } }
</style>
<%- include('partials/footer') %>