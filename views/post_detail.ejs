<%- include('partials/header') %>

<div class="container">
    <a href="/community" class="btn btn-outline" style="margin-bottom:20px;">&larr; Geri</a>

    <div class="card">
        <div style="display:flex; align-items:center; gap:15px; margin-bottom:15px;">
            <img src="<%= post.authorAvatar || '/img/default_avatar.png' %>" style="width:50px; height:50px; border-radius:50%;">
            <div>
                <h1 style="margin:0; font-size:1.8rem;"><%= post.title %></h1>
                <div style="font-size:13px; color:var(--text-muted);"><%= post.authorName %> • <%= new Date(post.created_at).toLocaleDateString() %></div>
            </div>
        </div>
        <div style="font-size:1.1rem; line-height:1.6; color:#e2e8f0;">
            <%= post.content %>
        </div>
    </div>

    <h3 style="margin-top:30px;">Yorumlar</h3>
    
    <% if(locals.user) { %>
        <form action="/comment/<%= post.id %>" method="POST" style="margin-bottom:30px; display:flex; gap:10px;">
            <input type="text" name="content" placeholder="Yorumunu buraya yaz..." required style="margin:0;">
            <button type="submit" class="btn btn-primary">Gönder</button>
        </form>
    <% } %>

    <% comments.forEach(c => { %>
        <div class="card" style="padding:15px; margin-bottom:10px; background:rgba(0,0,0,0.2); display:flex; justify-content:space-between; align-items:flex-start;">
            <div style="display:flex; gap:15px;">
                <img src="<%= c.userAvatar || '/img/default_avatar.png' %>" style="width:40px; height:40px; border-radius:50%;">
                <div>
                    <div style="display:flex; gap:10px; align-items:center;">
                        <span style="font-weight:bold; color:var(--primary);"><%= c.author %></span>
                        <span style="font-size:11px; color:var(--text-muted);"><%= new Date(c.created_at).toLocaleString() %></span>
                    </div>
                    <div style="margin-top:5px; color:#cbd5e1;"><%= c.content %></div>
                </div>
            </div>

            <% if(locals.user && locals.user.id === c.user_id) { %>
                <form action="/comment/delete/<%= c.id %>" method="POST" style="margin:0;" onsubmit="return confirm('Silmek istediğine emin misin?')">
                    <button type="submit" class="btn btn-danger" style="padding:4px 8px; font-size:11px;">Sil</button>
                </form>
            <% } %>
        </div>
    <% }) %>
</div>

<%- include('partials/footer') %>