<% if(locals.user) { %>
    <script src="/socket.io/socket.io.js"></script>
    <script>const chatSocket = io();</script>

    <div class="mini-chat-btn" onclick="toggleMiniChat()">
        <% if(locals.user.avatar && locals.user.avatar !== '/img/default_avatar.png') { %>
            <img src="<%= locals.user.avatar %>" class="mini-chat-avatar">
        <% } else { %>
            <i class="fas fa-comment-dots" style="font-size:30px; color:white;"></i>
        <% } %>
        
        <% if (locals.totalUnread && locals.totalUnread > 0) { %>
            <div class="badge-float" id="unreadBadge"><%= locals.totalUnread %></div>
        <% } %>
    </div>

    <div class="mini-chat-box" id="miniChatBox">
        <div style="background:var(--primary); padding:20px; color:white; font-weight:bold; display:flex; justify-content:space-between; align-items:center;">
            <span style="display:flex; align-items:center; gap:10px;"><i class="fas fa-comments"></i> Hızlı Sohbet</span>
            <span onclick="toggleMiniChat()" style="cursor:pointer; font-size:22px; opacity:0.8;">&times;</span>
        </div>
        <iframe src="/chat?mode=mini" style="width:100%; height:100%; border:none;"></iframe>
    </div>

    <script>
        function toggleMiniChat() {
            const box = document.getElementById('miniChatBox');
            const badge = document.getElementById('unreadBadge');
            
            if (box.style.display === 'flex') {
                box.style.display = 'none';
            } else {
                box.style.display = 'flex';
                if (badge) {
                    badge.style.display = 'none';
                    chatSocket.emit('clear_notifications', '<%= locals.user.id %>');
                }
            }
        }
    </script>
<% } %>
</body>
</html>