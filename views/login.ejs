<%- include('partials/header') %>
<style>
    body { background: #0b0f19 url('/img/anasayfa.png') no-repeat center center/cover; }
    .auth-card {
        background: rgba(17, 22, 37, 0.9); backdrop-filter: blur(10px);
        width: 100%; max-width: 400px; padding: 40px; border-radius: 15px;
        border: 1px solid #1f293a; margin: 80px auto; box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    }
    .auth-input { width: 100%; background: #0b0f19; border: 1px solid #333; color: white; padding: 12px; margin-bottom: 15px; border-radius: 6px; }
    .auth-input:focus { border-color: #8ec5fc; outline: none; }
    .btn-submit { width: 100%; background: #8ec5fc; color: black; font-weight: bold; padding: 12px; border: none; border-radius: 6px; cursor: pointer; transition: 0.3s; }
    .btn-submit:hover { background: white; box-shadow: 0 0 15px white; }
</style>

<div class="container">
    <div class="auth-card">
        <h2 style="color:white; text-align:center; margin-bottom:30px;">GİRİŞ YAP</h2>
        <% if (locals.error) { %> <div style="background:rgba(255,0,0,0.2); color:#ff6b6b; padding:10px; border-radius:5px; margin-bottom:15px; text-align:center;"><%= error %></div> <% } %>
        
        <form action="/login" method="POST">
            <input type="email" name="email" class="auth-input" placeholder="E-Posta Adresi" required>
            <input type="password" name="password" class="auth-input" placeholder="Şifre" required>
            <button type="submit" class="btn-submit">SİSTEME GİR</button>
        </form>
        <p style="text-align:center; color:#666; margin-top:20px; font-size:13px;">Hesabın yok mu? <a href="/register" style="color:#8ec5fc;">Kayıt Ol</a></p>
    </div>
</div>
<%- include('partials/footer') %>